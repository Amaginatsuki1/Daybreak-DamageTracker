Mods: {
	DaybreakDamageTracker: {
		UI: {
			UnknownBoss: 未知 Boss
			TeamTotal: 团队总伤害
			BossBodyDamage: 团队对 Boss 本体伤害
			BossBodyRow: 本体 {0}（{1}）
			Unattributed: 未归属持续/服务端伤害
			Duration: 战斗时长
			Ranking: 玩家伤害排名
			PersonalBreakdown: 你的伤害构成 — {0}
			PersonalBreakdownUnknown: 你的伤害构成
			NoDamage: 没有可归属的玩家伤害
			NoPersonalDamage: 你没有可统计伤害
			NoPrivateHistory: 这条历史记录没有本人的来源数据
			OtherPlayers: 其他 {0} 名玩家
			OtherProjectiles: ▶ 其他 {0} 种弹幕
			CollapseProjectiles: ▼ 收起弹幕列表
			CollapseProjectilesClipped: ▼ 收起（另有 {0} 种超出屏幕）
			OtherSources: ▶ 其他 {0} 个来源
			CollapseSources: ▼ 收起来源列表
			CollapseSourcesClipped: ▼ 收起来源列表（另有 {0} 个来源未显示）
			MoreRows: 另有 {0} 行来源已折叠
			ServerReconciled: 来源数值已按服务器确认的个人总伤害校准
			MountSource: 坐骑 #{0}
			ProjectileSource: 弹幕 #{0}
			Unclassified: 未分类伤害
			UnknownSource: 未知来源
			WeaponBody: 武器本体
			DotDamage: "{0} · 持续伤害"
			UnknownDebuff: 减益 #{0}
		}

		Outcome: {
			Unknown: 结算
			Victory: 胜利
			Defeat: 失败
			Escaped: Boss 已逃离
			Manual: 管理员结束
			Mixed: 混合结局
		}

		Chat.SavedResult: "{0}｜{1}｜{2}"

		Commands: {
			Dt: {
				Description: 打开或关闭已保存的伤害结算。
				NoHistory: 当前没有已保存的伤害结算。
				NoHistoryAtIndex: 当前没有可通过 /dt{0} 查看的一场结算。
			}
		}

		Configs: {
			ClientConfig: {
				DisplayName: Daybreak DamageTracker

				AutoShowResults: {
					Label: 自动弹出结算面板
					Tooltip: Boss 结算时自动显示面板。关闭后聊天记录和 /dt 手动查看仍然有效。
				}

				HistoryCount: {
					Label: 保留结算记录数
					Tooltip: 可保留最近 1 至 10 场 Boss 结算。最新一场使用 /dt，随后按需使用 /dt1 至 /dt9。
				}

				AutoHideSeconds: {
					Label: 自动面板持续时间
					Tooltip: 自动弹出的结算面板可持续 1 至 120 秒；点击、展开或滚动面板会重新开始计时。使用 /dt 手动打开的面板仍会一直保留到主动关闭。
				}

				PanelBackgroundOpacity: {
					Label: 面板底色不透明度
					Tooltip: 只调整面板深色底色；文字、Boss 头像、边框和按钮不会一起变透明。
				}
			}
		}
	}
}
