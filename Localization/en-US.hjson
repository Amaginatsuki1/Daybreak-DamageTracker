Mods: {
	DaybreakDamageTracker: {
		UI: {
			UnknownBoss: Unknown boss
			TeamTotal: Team total damage
			BossBodyDamage: Damage to boss body
			BossBodyRow: Body {0} ({1})
			Unattributed: Unattributed DoT/server-side damage
			Duration: Duration
			Ranking: Player damage ranking
			PersonalBreakdown: Your damage sources — {0}
			PersonalBreakdownUnknown: Your damage sources
			NoDamage: No attributable player damage
			NoPersonalDamage: You dealt no attributable damage
			NoPrivateHistory: No private source data is available for this result
			OtherPlayers: Other {0} players
			OtherProjectiles: ▶ Other {0} projectiles
			CollapseProjectiles: ▼ Collapse projectile list
			CollapseProjectilesClipped: ▼ Collapse ({0} projectiles do not fit)
			OtherSources: ▶ Other {0} sources
			CollapseSources: ▼ Collapse source list
			CollapseSourcesClipped: ▼ Collapse source list ({0} sources do not fit)
			MoreRows: "{0} more source rows collapsed"
			ServerReconciled: Source values were reconciled to the server-confirmed total
			MountSource: Mount #{0}
			ProjectileSource: Projectile #{0}
			Unclassified: Unclassified damage
			UnknownSource: Unknown source
			WeaponBody: Weapon body
			DotDamage: "{0} · damage over time"
			UnknownDebuff: Debuff #{0}
		}

		Outcome: {
			Unknown: Result
			Victory: Victory
			Defeat: Defeat
			Escaped: Boss escaped
			Manual: Manually ended
			Mixed: Mixed outcomes
		}

		Chat.SavedResult: "{0} | {1} | {2}"

		Commands: {
			Dt: {
				Description: Open or close saved damage results.
				NoHistory: No saved damage result is available.
				NoHistoryAtIndex: No saved damage result is available through /dt{0}.
			}
		}

		Configs: {
			ClientConfig: {
				DisplayName: Daybreak DamageTracker

				AutoShowResults: {
					Label: Automatically show result panel
					Tooltip: Show a boss result panel automatically when that boss concludes. Chat history and /dt remain available when disabled.
				}

				HistoryCount: {
					Label: Saved result count
					Tooltip: Keep 1 to 10 recent boss results. The latest uses /dt, followed by /dt1 through /dt9 as needed.
				}

				AutoHideSeconds: {
					Label: Automatic panel duration
					Tooltip: Keep an automatically opened result panel visible for 1 to 120 seconds. Interacting with it restarts this timer. Panels opened manually with /dt remain open until closed.
				}

				PanelBackgroundOpacity: {
					Label: Panel background opacity
					Tooltip: Adjust only the dark panel background. Text, portraits, borders, and buttons remain fully visible.
				}
			}
		}
	}
}
